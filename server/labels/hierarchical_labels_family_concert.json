{
  "version": "family_concert_v1",
  "date": "2026-08-19",
  "context": "young-families concert audience (docile, mostly seated). Distinct from the online-class / direct-camera context served by the older 86-class models, where direct camera gaze and distance-from-camera strongly drive the score.",
  "source_dataset": "kinetics-700",
  "based_on": "server/labels/hierarchical_labels_young_families.json",
  "status": "trainer-ready. Consumed by scripts/train_young_families.py via --hierarchical-file. Train against a feature tree filtered to 'train_classes' (see scripts/data/build_family_concert_feature_tree.py). 'to_extract' classes require feature extraction before they can be trained.",
  "philosophy": "attention-first; presume engaged; low arousal is NOT disengagement; quiet attentive stillness/staring is the strongest engagement cue; disengagement = distraction, distress, restlessness or boredom; neutral/involuntary/consumption actions are excluded; the action head acts mainly as a distraction/distress detector on top of the attentive-presence baseline.",
  "binary": {
    "num_classes": 2,
    "action_to_idx": {
      "engagement": 0,
      "disengagement": 1
    },
    "idx_to_action": {
      "0": "engagement",
      "1": "disengagement"
    },
    "classes": [
      "engagement",
      "disengagement"
    ]
  },
  "hierarchy": {
    "applause": {
      "binary": "engagement",
      "fine_classes": [
        "applauding",
        "clapping"
      ]
    },
    "attention": {
      "binary": "engagement",
      "fine_classes": [
        "staring"
      ]
    },
    "sing_along": {
      "binary": "engagement",
      "fine_classes": [
        "karaoke"
      ]
    },
    "positive_reaction": {
      "binary": "engagement",
      "fine_classes": [
        "laughing"
      ]
    },
    "phone_distraction": {
      "binary": "disengagement",
      "fine_classes": [
        "looking at phone",
        "texting",
        "talking on cell phone"
      ]
    },
    "restless_bored": {
      "binary": "disengagement",
      "fine_classes": [
        "fidgeting",
        "checking watch",
        "yawning"
      ]
    },
    "disengaged_state": {
      "binary": "disengagement",
      "fine_classes": [
        "sleeping"
      ]
    },
    "distress": {
      "binary": "disengagement",
      "fine_classes": [
        "crying",
        "falling off chair"
      ]
    }
  },
  "conversions": {
    "fine_to_binary": {
      "staring": "engagement",
      "applauding": "engagement",
      "clapping": "engagement",
      "karaoke": "engagement",
      "laughing": "engagement",
      "looking at phone": "disengagement",
      "texting": "disengagement",
      "talking on cell phone": "disengagement",
      "fidgeting": "disengagement",
      "checking watch": "disengagement",
      "yawning": "disengagement",
      "sleeping": "disengagement",
      "crying": "disengagement",
      "falling off chair": "disengagement"
    }
  },
  "train_classes": [
    "staring",
    "applauding",
    "clapping",
    "looking at phone",
    "texting",
    "talking on cell phone",
    "fidgeting",
    "checking watch",
    "yawning",
    "sleeping",
    "crying",
    "falling off chair",
    "karaoke",
    "laughing"
  ],
  "to_extract": {
    "karaoke": {
      "binary": "engagement",
      "note": "sing-along proxy (better-posed than 'singing')"
    },
    "laughing": {
      "binary": "engagement",
      "note": "optional; positive reaction"
    }
  },
  "feature_layer_signals": {
    "attentive_stillness_gaze_on_stage": {
      "polarity": "+",
      "source": "gaze + orientation"
    },
    "looking_away_reduced_attention": {
      "polarity": "-",
      "source": "gaze"
    },
    "excess_movement_restlessness": {
      "polarity": "-",
      "source": "motion-energy/synchrony (replaces dance action-classes for 'kids moving a lot')"
    },
    "tapping_along_to_rhythm": {
      "polarity": "+",
      "source": "in-domain data / rhythm cue"
    }
  },
  "overrides_vs_standard": [
    "staring: disengagement -> engagement (attentive stillness = strongest positive cue)",
    "dropped 74 of the original 86 classes as neutral/irrelevant/undetectable (see dropped_neutral)",
    "added karaoke (sing-along) and laughing (optional) as engagement classes to extract",
    "engagement class up-weighted via --engagement-weight (presume-engaged tilt)"
  ],
