# AMPLIFY Pilot 0 Infrastructure Configuration
# Copy this file to .env and set the values for your environment

# Redis server URL
# Format: redis://[username[:password]@]host[:port][/database]
# Example: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Channel name for publishing engagement estimations
# Default follows AMPLIFY convention: amplify.engagement
ENGAGEMENT_CHANNEL=amplify.engagement
